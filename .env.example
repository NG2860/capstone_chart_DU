# Copy this file to backend/.env and fill in your actual values
# NEVER commit the real .env file with actual API keys

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-1.5-flash
GEMINI_RETRIES_PER_MODEL=2
GEMINI_RETRY_DELAY_SECONDS=1.5

# Comma-separated list. Use your Vercel domain in production.
CORS_ORIGINS=*

# AI usage and upload limits
DAILY_LIMIT=1000
MAX_FILES=5
MAX_UPLOAD_BYTES=10485760
